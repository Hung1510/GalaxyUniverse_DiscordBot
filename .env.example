# Discord bot token from https://discord.com/developers/applications/<APP_ID>/bot
# 50+ chars, three dot-separated parts (xxx.yyy.zzz)
DISCORD_TOKEN=your-token-here

# Path to SQLite file (default: data/galaxy.db). On Onidel/Railway, mount
# persistent storage at /data and set DATABASE_PATH=/data/galaxy.db
DATABASE_PATH=data/galaxy.db

# 'development' or 'production'. In production, debug logs are suppressed.
NODE_ENV=development

# Optional: channel ID for cross-guild bot-level events (deploy notify, errors)
# BOT_LOG_CHANNEL_ID=
