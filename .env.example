# Discord bot token from https://discord.com/developers/applications
# (See SETUP.md for how to get this)
DISCORD_TOKEN=your-bot-token-here

# Path to SQLite database file. On Railway, point this to the mounted volume
# e.g. /data/galaxy.db
DATABASE_PATH=./data/galaxy.db

# Bot prefix (per spec: "g!")
PREFIX=g!

# 'development' or 'production' — affects logging verbosity
NODE_ENV=development
